# Your Anthropic API key, from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional Langfuse tracing, from your project's settings at https://cloud.langfuse.com
# Leave the keys empty to turn tracing off.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# The EU region is the default. For the US region, use https://us.cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com
